{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-stack.ipod-photo-demo",
  "name": "pocketjs-ipod-photo-demo",
  "title": "PocketJS: iPod Photo Qualification",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": [
        "text.glyphs.baked",
        "input.buttons"
      ]
    }
  },
  "app": {
    "entry": "apps/ipod-photo-demo/main.tsx",
    "output": "ipod-photo-demo-main",
    "framework": "solid",
    "viewport": {
      "fixed": {
        "logical": [
          220,
          176
        ],
        "presentation": "native"
      }
    }
  }
}
