{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-stack.ipod-photo-beta",
  "name": "pocketjs-ipod-photo-beta",
  "title": "PocketJS: Beta",
  "version": "0.1.0",
  "engine": {
    "capabilities": { "requires": ["text.glyphs.baked", "input.buttons"] }
  },
  "app": {
    "entry": "apps/ipod-photo-multi/beta-main.tsx",
    "output": "ipod-photo-beta-main",
    "framework": "solid",
    "viewport": {
      "fixed": { "logical": [220, 176], "presentation": "native" }
    }
  }
}
